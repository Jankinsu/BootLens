<Window
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    Title="BootLens"
    Width="1040"
    Height="720"
    MinWidth="860"
    MinHeight="600"
    WindowStartupLocation="CenterScreen"
    Background="#F3F4F6"
    FontFamily="Segoe UI">
    <Window.Resources>
        <SolidColorBrush x:Key="PrimaryBrush" Color="#2563EB" />
        <SolidColorBrush x:Key="HeadingBrush" Color="#111827" />
        <SolidColorBrush x:Key="MutedBrush" Color="#6B7280" />

        <Style x:Key="CardStyle" TargetType="Border">
            <Setter Property="Background" Value="White" />
            <Setter Property="BorderBrush" Value="#E5E7EB" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="CornerRadius" Value="10" />
            <Setter Property="Padding" Value="20" />
            <Setter Property="Margin" Value="0,0,12,0" />
        </Style>

        <Style TargetType="Button">
            <Setter Property="Background" Value="#2563EB" />
            <Setter Property="Foreground" Value="White" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="Padding" Value="18,9" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Cursor" Value="Hand" />
        </Style>

        <Style TargetType="ProgressBar">
            <Setter Property="Height" Value="8" />
            <Setter Property="Maximum" Value="100" />
            <Setter Property="Foreground" Value="#2563EB" />
            <Setter Property="Background" Value="#E5E7EB" />
        </Style>
    </Window.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <Border Grid.Row="0" Background="#111827" Padding="28,22">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <StackPanel>
                    <TextBlock
                        Foreground="White"
                        FontSize="26"
                        FontWeight="Bold"
                        Text="BootLens" />
                    <TextBlock
                        Margin="0,5,0,0"
                        Foreground="#9CA3AF"
                        FontSize="13"
                        Text="Windows 启动历史 · 启动项发现 · 进程时间线 · 启动退化" />
                </StackPanel>

                <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                    <TextBlock
                        x:Name="CountLabelText"
                        Margin="0,0,8,0"
                        VerticalAlignment="Center"
                        Foreground="#D1D5DB"
                        Text="显示" />
                    <ComboBox
                        x:Name="CountComboBox"
                        Width="70"
                        Margin="0,0,12,0"
                        Padding="6"
                        SelectedIndex="3">
                        <ComboBoxItem Content="5" />
                        <ComboBoxItem Content="10" />
                        <ComboBoxItem Content="20" />
                        <ComboBoxItem Content="30" />
                        <ComboBoxItem Content="50" />
                    </ComboBox>
                    <Button x:Name="RefreshButton" Content="刷新" />
                </StackPanel>
            </Grid>
        </Border>

        <Border
            x:Name="ErrorBorder"
            Grid.Row="1"
            Margin="24,18,24,0"
            Padding="14,10"
            Background="#FEF2F2"
            BorderBrush="#FECACA"
            BorderThickness="1"
            CornerRadius="8"
            Visibility="Collapsed">
            <TextBlock
                x:Name="ErrorTextBlock"
                Foreground="#991B1B"
                TextWrapping="Wrap" />
        </Border>

        <TabControl x:Name="MainTabControl" Grid.Row="2" Background="Transparent" BorderThickness="0">
            <TabItem Header="启动历史">
                <ScrollViewer VerticalScrollBarVisibility="Auto">
                    <StackPanel Margin="24,20,12,24">
                <Border
                    x:Name="BootHistoryStatusBorder"
                    Margin="0,0,12,16"
                    Padding="14,10"
                    Background="#FFF7ED"
                    BorderBrush="#FED7AA"
                    BorderThickness="1"
                    CornerRadius="8"
                    Visibility="Collapsed">
                    <TextBlock x:Name="BootHistoryStatusText" Foreground="#9A3412" TextWrapping="Wrap" />
                </Border>
                <UniformGrid Columns="4" Margin="0,0,0,20">
                    <Border Style="{StaticResource CardStyle}">
                        <StackPanel>
                            <TextBlock Foreground="{StaticResource MutedBrush}" Text="上次完整启动" />
                            <TextBlock
                                x:Name="LastBootValue"
                                Margin="0,8,0,0"
                                Foreground="{StaticResource HeadingBrush}"
                                FontSize="28"
                                FontWeight="Bold"
                                Text="--" />
                        </StackPanel>
                    </Border>
                    <Border Style="{StaticResource CardStyle}">
                        <StackPanel>
                            <TextBlock Foreground="{StaticResource MutedBrush}" Text="平均" />
                            <TextBlock
                                x:Name="AverageValue"
                                Margin="0,8,0,0"
                                Foreground="{StaticResource HeadingBrush}"
                                FontSize="28"
                                FontWeight="Bold"
                                Text="--" />
                        </StackPanel>
                    </Border>
                    <Border Style="{StaticResource CardStyle}">
                        <StackPanel>
                            <TextBlock Foreground="{StaticResource MutedBrush}" Text="最快" />
                            <TextBlock
                                x:Name="FastestValue"
                                Margin="0,8,0,0"
                                Foreground="#047857"
                                FontSize="28"
                                FontWeight="Bold"
                                Text="--" />
                        </StackPanel>
                    </Border>
                    <Border Style="{StaticResource CardStyle}">
                        <StackPanel>
                            <TextBlock Foreground="{StaticResource MutedBrush}" Text="最慢" />
                            <TextBlock
                                x:Name="SlowestValue"
                                Margin="0,8,0,0"
                                Foreground="#B45309"
                                FontSize="28"
                                FontWeight="Bold"
                                Text="--" />
                        </StackPanel>
                    </Border>
                </UniformGrid>

                <Border Margin="0,0,12,20" Style="{StaticResource CardStyle}">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="32" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>

                        <StackPanel Grid.Row="0" Grid.ColumnSpan="3" Margin="0,0,0,18">
                            <TextBlock
                                Foreground="{StaticResource HeadingBrush}"
                                FontSize="17"
                                FontWeight="SemiBold"
                                Text="最近一次启动构成" />
                            <TextBlock
                                x:Name="LatestBootTimeText"
                                Margin="0,5,0,0"
                                Foreground="{StaticResource MutedBrush}"
                                Text="--" />
                        </StackPanel>

                        <StackPanel Grid.Row="1" Grid.Column="0">
                            <DockPanel Margin="0,0,0,8">
                                <TextBlock DockPanel.Dock="Left" Foreground="{StaticResource MutedBrush}" Text="桌面出现前 · Main Path" />
                                <TextBlock
                                    x:Name="MainPathValue"
                                    HorizontalAlignment="Right"
                                    Foreground="{StaticResource HeadingBrush}"
                                    FontWeight="SemiBold"
                                    Text="--" />
                            </DockPanel>
                            <ProgressBar x:Name="MainPathProgress" />
                        </StackPanel>

                        <StackPanel Grid.Row="1" Grid.Column="2">
                            <DockPanel Margin="0,0,0,8">
                                <TextBlock DockPanel.Dock="Left" Foreground="{StaticResource MutedBrush}" Text="桌面出现后 · Post Boot" />
                                <TextBlock
                                    x:Name="PostBootValue"
                                    HorizontalAlignment="Right"
                                    Foreground="{StaticResource HeadingBrush}"
                                    FontWeight="SemiBold"
                                    Text="--" />
                            </DockPanel>
                            <ProgressBar x:Name="PostBootProgress" Foreground="#7C3AED" />
                        </StackPanel>
                    </Grid>
                </Border>

                <Border Margin="0,0,12,20" Style="{StaticResource CardStyle}">
                    <StackPanel>
                        <TextBlock
                            Foreground="{StaticResource HeadingBrush}"
                            FontSize="17"
                            FontWeight="SemiBold"
                            Text="完整启动耗时趋势" />
                        <TextBlock
                            x:Name="TrendSummaryText"
                            Margin="0,6,0,10"
                            Foreground="{StaticResource MutedBrush}"
                            Text="等待启动记录..."
                            TextWrapping="Wrap" />
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                            </Grid.RowDefinitions>
                            <Viewbox Grid.Row="0" Height="220" Stretch="Fill" StretchDirection="Both">
                                <Canvas x:Name="TrendChartCanvas" Width="900" Height="202" />
                            </Viewbox>
                            <StackPanel Grid.Row="1" Orientation="Horizontal" HorizontalAlignment="Center" Margin="0,4,0,0">
                                <TextBlock Foreground="#2563EB" FontWeight="SemiBold" Text="● 总耗时" Margin="8,0" />
                                <TextBlock Foreground="#7C3AED" FontWeight="SemiBold" Text="● Main Path" Margin="8,0" />
                                <TextBlock Foreground="#059669" FontWeight="SemiBold" Text="● Post Boot" Margin="8,0" />
                            </StackPanel>
                        </Grid>
                        <TextBlock
                            Margin="0,5,0,0"
                            Foreground="{StaticResource MutedBrush}"
                            FontSize="11"
                            Text="纵轴按当前样本范围缩放；曲线表示 Windows 记录的实测值，不表示单个程序的耗时或因果影响。" />
                    </StackPanel>
                </Border>

                <Border Margin="0,0,12,20" Style="{StaticResource CardStyle}">
                    <StackPanel>
                        <TextBlock
                            Foreground="{StaticResource HeadingBrush}"
                            FontSize="17"
                            FontWeight="SemiBold"
                            Text="Windows 诊断观察" />
                        <TextBlock
                            x:Name="DiagnosticSummaryText"
                            Margin="0,8,0,0"
                            Foreground="{StaticResource HeadingBrush}"
                            Text="等待 Windows 诊断记录..."
                            TextWrapping="Wrap" />
                        <TextBlock
                            Margin="0,7,0,0"
                            Foreground="{StaticResource MutedBrush}"
                            FontSize="11"
                            Text="依据 Event 100 的 Windows 退化标记汇总；该标记不指出具体原因或责任应用。未标记也不等于没有用户可感知的变慢。Event 101 诊断记录仍在独立页面展示。"
                            TextWrapping="Wrap" />
                    </StackPanel>
                </Border>

                <Border Margin="0,0,12,0" Style="{StaticResource CardStyle}">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="*" />
                        </Grid.RowDefinitions>

                        <Grid Margin="0,0,0,14">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <TextBlock
                                Foreground="{StaticResource HeadingBrush}"
                                FontSize="17"
                                FontWeight="SemiBold"
                                Text="最近完整启动" />
                            <TextBlock
                                x:Name="SampleCountText"
                                Grid.Column="1"
                                Foreground="{StaticResource MutedBrush}"
                                Text="--" />
                        </Grid>

                        <DataGrid
                            x:Name="HistoryDataGrid"
                            Grid.Row="1"
                            AutoGenerateColumns="False"
                            BorderThickness="0"
                            CanUserAddRows="False"
                            CanUserDeleteRows="False"
                            CanUserReorderColumns="False"
                            CanUserResizeRows="False"
                            HeadersVisibility="Column"
                            IsReadOnly="True"
                            RowHeaderWidth="0"
                            SelectionMode="Single"
                            GridLinesVisibility="Horizontal"
                            HorizontalGridLinesBrush="#E5E7EB">
                            <DataGrid.Columns>
                                <DataGridTextColumn Width="2*" Binding="{Binding Started}" Header="启动时间" />
                                <DataGridTextColumn Width="*" Binding="{Binding Total}" Header="总耗时" />
                                <DataGridTextColumn Width="*" Binding="{Binding MainPath}" Header="Main Path" />
                                <DataGridTextColumn Width="*" Binding="{Binding PostBoot}" Header="Post Boot" />
                                <DataGridTextColumn Width="*" Binding="{Binding Apps}" Header="启动应用" />
                                <DataGridTextColumn Width="1.4*" Binding="{Binding Status}" Header="Windows 判断" />
                            </DataGrid.Columns>
                        </DataGrid>
                    </Grid>
                </Border>
                    </StackPanel>
                </ScrollViewer>
            </TabItem>

            <TabItem Header="启动项">
                <ScrollViewer VerticalScrollBarVisibility="Auto">
                    <StackPanel Margin="24,20,12,24">
                        <UniformGrid Columns="6" Margin="0,0,0,20">
                            <Border Style="{StaticResource CardStyle}">
                                <StackPanel>
                                    <TextBlock Foreground="{StaticResource MutedBrush}" Text="启动配置" />
                                    <TextBlock
                                        x:Name="StartupTotalValue"
                                        Margin="0,8,0,0"
                                        Foreground="{StaticResource HeadingBrush}"
                                        FontSize="28"
                                        FontWeight="Bold"
                                        Text="--" />
                                </StackPanel>
                            </Border>
                            <Border Style="{StaticResource CardStyle}">
                                <StackPanel>
                                    <TextBlock Foreground="{StaticResource MutedBrush}" Text="Registry Run" />
                                    <TextBlock
                                        x:Name="RegistryStartupCountValue"
                                        Margin="0,8,0,0"
                                        Foreground="#2563EB"
                                        FontSize="28"
                                        FontWeight="Bold"
                                        Text="--" />
                                </StackPanel>
                            </Border>
                            <Border Style="{StaticResource CardStyle}">
                                <StackPanel>
                                    <TextBlock Foreground="{StaticResource MutedBrush}" Text="Startup Folder" />
                                    <TextBlock
                                        x:Name="FolderStartupCountValue"
                                        Margin="0,8,0,0"
                                        Foreground="#7C3AED"
                                        FontSize="28"
                                        FontWeight="Bold"
                                        Text="--" />
                                </StackPanel>
                            </Border>
                            <Border Style="{StaticResource CardStyle}">
                                <StackPanel>
                                    <TextBlock Foreground="{StaticResource MutedBrush}" Text="Scheduled Tasks" />
                                    <TextBlock
                                        x:Name="TaskStartupCountValue"
                                        Margin="0,8,0,0"
                                        Foreground="#0891B2"
                                        FontSize="28"
                                        FontWeight="Bold"
                                        Text="--" />
                                </StackPanel>
                            </Border>
                            <Border Style="{StaticResource CardStyle}">
                                <StackPanel>
                                    <TextBlock Foreground="{StaticResource MutedBrush}" Text="Windows Services" />
                                    <TextBlock
                                        x:Name="ServiceStartupCountValue"
                                        Margin="0,8,0,0"
                                        Foreground="#059669"
                                        FontSize="28"
                                        FontWeight="Bold"
                                        Text="--" />
                                </StackPanel>
                            </Border>
                            <Border Style="{StaticResource CardStyle}">
                                <StackPanel>
                                    <TextBlock Foreground="{StaticResource MutedBrush}" Text="未解析目标" />
                                    <TextBlock
                                        x:Name="UnresolvedStartupCountValue"
                                        Margin="0,8,0,0"
                                        Foreground="#B45309"
                                        FontSize="28"
                                        FontWeight="Bold"
                                        Text="--" />
                                </StackPanel>
                            </Border>
                        </UniformGrid>

                        <Border
                            Margin="0,0,12,20"
                            Padding="16,12"
                            Background="#EFF6FF"
                            BorderBrush="#BFDBFE"
                            BorderThickness="1"
                            CornerRadius="8">
                            <TextBlock
                                Foreground="#1E3A8A"
                                Text="这里展示自动启动配置，不表示它们拖慢了多少。服务延迟启动会单独标明；其他来源的未知状态不会猜测。"
                                TextWrapping="Wrap" />
                        </Border>

                        <Border Margin="0,0,12,0" Style="{StaticResource CardStyle}">
                            <Grid>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="*" />
                                </Grid.RowDefinitions>

                                <Grid Margin="0,0,0,14">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <TextBlock
                                        Foreground="{StaticResource HeadingBrush}"
                                        FontSize="17"
                                        FontWeight="SemiBold"
                                        Text="启动项发现" />
                                    <TextBlock
                                        x:Name="StartupItemCountText"
                                        Grid.Column="1"
                                        Foreground="{StaticResource MutedBrush}"
                                        Text="--" />
                                </Grid>

                                <Grid Grid.Row="1" Margin="0,0,0,12">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="220" />
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="190" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>
                                    <TextBlock
                                        Margin="0,0,8,0"
                                        VerticalAlignment="Center"
                                        Foreground="{StaticResource MutedBrush}"
                                        Text="搜索名称或目标" />
                                    <TextBox
                                        x:Name="StartupSearchTextBox"
                                        Grid.Column="1"
                                        Padding="7,5"
                                        VerticalContentAlignment="Center" />
                                    <TextBlock
                                        Grid.Column="2"
                                        Margin="18,0,8,0"
                                        VerticalAlignment="Center"
                                        Foreground="{StaticResource MutedBrush}"
                                        Text="来源" />
                                    <ComboBox
                                        x:Name="StartupSourceFilterComboBox"
                                        Grid.Column="3"
                                        Padding="6"
                                        SelectedIndex="0">
                                        <ComboBoxItem Content="全部来源" />
                                        <ComboBoxItem Content="Registry Run" />
                                        <ComboBoxItem Content="Startup Folder" />
                                        <ComboBoxItem Content="Scheduled Task" />
                                        <ComboBoxItem Content="Windows Service" />
                                    </ComboBox>
                                </Grid>

                                <DataGrid
                                    x:Name="StartupItemsDataGrid"
                                    Grid.Row="2"
                                    AutoGenerateColumns="False"
                                    BorderThickness="0"
                                    CanUserAddRows="False"
                                    CanUserDeleteRows="False"
                                    CanUserReorderColumns="False"
                                    CanUserResizeRows="False"
                                    HeadersVisibility="Column"
                                    IsReadOnly="True"
                                    RowHeaderWidth="0"
                                    SelectionMode="Single"
                                    GridLinesVisibility="Horizontal"
                                    HorizontalGridLinesBrush="#E5E7EB">
                                    <DataGrid.Columns>
                                        <DataGridTextColumn Width="1.8*" Binding="{Binding Name}" Header="名称" />
                                        <DataGridTextColumn Width="1.1*" Binding="{Binding Source}" Header="来源" />
                                        <DataGridTextColumn Width="*" Binding="{Binding Scope}" Header="作用域" />
                                        <DataGridTextColumn Width="2.8*" Binding="{Binding Executable}" Header="可执行文件" />
                                        <DataGridTextColumn Width="1.4*" Binding="{Binding Publisher}" Header="Publisher" />
                                        <DataGridTextColumn Width="*" Binding="{Binding Resolution}" Header="解析状态" />
                                        <DataGridTextColumn Width="*" Binding="{Binding Enabled}" Header="启用/启动状态" />
                                    </DataGrid.Columns>
                                </DataGrid>
                            </Grid>
                        </Border>
                    </StackPanel>
                </ScrollViewer>
            </TabItem>

            <TabItem x:Name="ProcessTimelineTab" Header="进程时间线">
                <ScrollViewer VerticalScrollBarVisibility="Auto">
                    <StackPanel Margin="24,20,12,24">
                        <Border
                            x:Name="ProcessTimelineStatusBorder"
                            Margin="0,0,12,16"
                            Padding="14,10"
                            Background="#FFF7ED"
                            BorderBrush="#FED7AA"
                            BorderThickness="1"
                            CornerRadius="8"
                            Visibility="Collapsed">
                            <TextBlock x:Name="ProcessTimelineStatusText" Foreground="#9A3412" TextWrapping="Wrap" />
                        </Border>
                        <UniformGrid Columns="3" Margin="0,0,0,20">
                            <Border Style="{StaticResource CardStyle}">
                                <StackPanel>
                                    <TextBlock Foreground="{StaticResource MutedBrush}" Text="运行中进程" />
                                    <TextBlock
                                        x:Name="ProcessTotalValue"
                                        Margin="0,8,0,0"
                                        Foreground="{StaticResource HeadingBrush}"
                                        FontSize="28"
                                        FontWeight="Bold"
                                        Text="--" />
                                </StackPanel>
                            </Border>
                            <Border Style="{StaticResource CardStyle}">
                                <StackPanel>
                                    <TextBlock Foreground="{StaticResource MutedBrush}" Text="时间戳可读" />
                                    <TextBlock
                                        x:Name="ProcessTimestampedValue"
                                        Margin="0,8,0,0"
                                        Foreground="#059669"
                                        FontSize="28"
                                        FontWeight="Bold"
                                        Text="--" />
                                </StackPanel>
                            </Border>
                            <Border Style="{StaticResource CardStyle}">
                                <StackPanel>
                                    <TextBlock Foreground="{StaticResource MutedBrush}" Text="时间不可用" />
                                    <TextBlock
                                        x:Name="ProcessUnavailableValue"
                                        Margin="0,8,0,0"
                                        Foreground="#B45309"
                                        FontSize="28"
                                        FontWeight="Bold"
                                        Text="--" />
                                </StackPanel>
                            </Border>
                            <Border Style="{StaticResource CardStyle}">
                                <StackPanel>
                                    <TextBlock Foreground="{StaticResource MutedBrush}" Text="早于启动锚点" />
                                    <TextBlock
                                        x:Name="ProcessNegativeOffsetValue"
                                        Margin="0,8,0,0"
                                        Foreground="#7C3AED"
                                        FontSize="28"
                                        FontWeight="Bold"
                                        Text="--" />
                                </StackPanel>
                            </Border>
                        </UniformGrid>

                        <Border
                            Margin="0,0,12,20"
                            Padding="16,12"
                            Background="#EFF6FF"
                            BorderBrush="#BFDBFE"
                            BorderThickness="1"
                            CornerRadius="8">
                            <TextBlock
                                Foreground="#1E3A8A"
                                Text="这里是扫描时仍在运行的进程快照，不包含已退出进程的历史记录。Boot Offset 是进程创建时间相对完整启动锚点的时间，允许出现小幅负值。需要管理员权限。"
                                TextWrapping="Wrap" />
                        </Border>

                        <Border Margin="0,0,12,0" Style="{StaticResource CardStyle}">
                            <Grid>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="*" />
                                </Grid.RowDefinitions>
                                <Grid Margin="0,0,0,14">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <TextBlock
                                        Foreground="{StaticResource HeadingBrush}"
                                        FontSize="17"
                                        FontWeight="SemiBold"
                                        Text="当前启动进程" />
                                    <TextBlock
                                        x:Name="ProcessSnapshotText"
                                        Grid.Column="1"
                                        Foreground="{StaticResource MutedBrush}"
                                        Text="尚未扫描" />
                                </Grid>
                                <DataGrid
                                    x:Name="ProcessTimelineDataGrid"
                                    Grid.Row="1"
                                    AutoGenerateColumns="False"
                                    BorderThickness="0"
                                    CanUserAddRows="False"
                                    CanUserDeleteRows="False"
                                    CanUserReorderColumns="False"
                                    CanUserResizeRows="False"
                                    HeadersVisibility="Column"
                                    IsReadOnly="True"
                                    RowHeaderWidth="0"
                                    RowDetailsVisibilityMode="VisibleWhenSelected"
                                    SelectionMode="Single"
                                    GridLinesVisibility="Horizontal"
                                    HorizontalGridLinesBrush="#E5E7EB">
                                    <DataGrid.Columns>
                                        <DataGridTextColumn Width="1.5*" Binding="{Binding Name}" Header="进程" />
                                        <DataGridTextColumn Width="0.7*" Binding="{Binding ProcessId}" Header="PID" />
                                        <DataGridTextColumn Width="0.8*" Binding="{Binding ParentProcessId}" Header="父 PID" />
                                        <DataGridTextColumn Width="1.4*" Binding="{Binding Started}" Header="启动时间" />
                                        <DataGridTextColumn Width="1*" Binding="{Binding BootOffset}" Header="Boot Offset" />
                                        <DataGridTextColumn Width="3*" Binding="{Binding ExecutablePath}" Header="可执行文件">
                                            <DataGridTextColumn.ElementStyle>
                                                <Style TargetType="TextBlock">
                                                    <Setter Property="TextTrimming" Value="CharacterEllipsis" />
                                                    <Setter Property="ToolTip" Value="{Binding ExecutablePath}" />
                                                </Style>
                                            </DataGridTextColumn.ElementStyle>
                                        </DataGridTextColumn>
                                    </DataGrid.Columns>
                                    <DataGrid.RowDetailsTemplate>
                                        <DataTemplate>
                                            <Border
                                                Padding="12,10"
                                                Background="#F9FAFB"
                                                BorderBrush="#E5E7EB"
                                                BorderThickness="0,1,0,0">
                                                <StackPanel>
                                                    <TextBlock
                                                        Margin="0,0,0,6"
                                                        Foreground="{StaticResource MutedBrush}"
                                                        FontSize="12"
                                                        Text="完整可执行文件路径（可选择并复制）" />
                                                    <TextBox
                                                        MaxHeight="100"
                                                        MinHeight="34"
                                                        AcceptsReturn="True"
                                                        HorizontalScrollBarVisibility="Disabled"
                                                        IsReadOnly="True"
                                                        Text="{Binding ExecutablePath, Mode=OneWay}"
                                                        TextWrapping="Wrap"
                                                        VerticalScrollBarVisibility="Auto" />
                                                </StackPanel>
                                            </Border>
                                        </DataTemplate>
                                    </DataGrid.RowDetailsTemplate>
                                </DataGrid>
                            </Grid>
                        </Border>
                    </StackPanel>
                </ScrollViewer>
            </TabItem>

            <TabItem x:Name="DegradationTab" Header="启动退化">
                <ScrollViewer VerticalScrollBarVisibility="Auto">
                    <StackPanel Margin="24,20,12,24">
                        <Border
                            x:Name="DegradationStatusBorder"
                            Margin="0,0,12,16"
                            Padding="14,10"
                            Background="#FFF7ED"
                            BorderBrush="#FED7AA"
                            BorderThickness="1"
                            CornerRadius="8"
                            Visibility="Collapsed">
                            <TextBlock x:Name="DegradationStatusText" Foreground="#9A3412" TextWrapping="Wrap" />
                        </Border>
                        <UniformGrid Columns="4" Margin="0,0,0,20">
                            <Border Style="{StaticResource CardStyle}">
                                <StackPanel>
                                    <TextBlock Foreground="{StaticResource MutedBrush}" Text="Event 101 记录" />
                                    <TextBlock x:Name="DegradationEventCountValue" Margin="0,8,0,0" Foreground="{StaticResource HeadingBrush}" FontSize="28" FontWeight="Bold" Text="--" />
                                </StackPanel>
                            </Border>
                            <Border Style="{StaticResource CardStyle}">
                                <StackPanel>
                                    <TextBlock Foreground="{StaticResource MutedBrush}" Text="已关联完整启动" />
                                    <TextBlock x:Name="DegradationMatchedBootCountValue" Margin="0,8,0,0" Foreground="#059669" FontSize="28" FontWeight="Bold" Text="--" />
                                </StackPanel>
                            </Border>
                            <Border Style="{StaticResource CardStyle}">
                                <StackPanel>
                                    <TextBlock Foreground="{StaticResource MutedBrush}" Text="路径精确匹配" />
                                    <TextBlock x:Name="DegradationExactPathCountValue" Margin="0,8,0,0" Foreground="#2563EB" FontSize="28" FontWeight="Bold" Text="--" />
                                </StackPanel>
                            </Border>
                        </UniformGrid>

                        <Border Margin="0,0,12,20" Padding="16,12" Background="#EFF6FF" BorderBrush="#BFDBFE" BorderThickness="1" CornerRadius="8">
                            <TextBlock Foreground="#1E3A8A" Text="每行是一条 Windows 诊断事件。退化值是 Windows 报告的原始指标，不等于该程序造成的启动延迟。选中一行可查看详情。" TextWrapping="Wrap" />
                        </Border>

                        <Border Margin="0,0,12,0" Style="{StaticResource CardStyle}">
                            <Grid>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="*" />
                                </Grid.RowDefinitions>
                                <Grid Margin="0,0,0,14">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Foreground="{StaticResource HeadingBrush}" FontSize="17" FontWeight="SemiBold" Text="Windows 启动退化事件" />
                                    <TextBlock x:Name="DegradationListStatusText" Grid.Column="1" Foreground="{StaticResource MutedBrush}" Text="尚未读取" />
                                </Grid>
                                <DataGrid
                                    x:Name="DegradationDataGrid"
                                    Grid.Row="1"
                                    AutoGenerateColumns="False"
                                    BorderThickness="0"
                                    CanUserAddRows="False"
                                    CanUserDeleteRows="False"
                                    CanUserReorderColumns="False"
                                    CanUserResizeRows="False"
                                    HeadersVisibility="Column"
                                    IsReadOnly="True"
                                    RowDetailsVisibilityMode="VisibleWhenSelected"
                                    RowHeaderWidth="0"
                                    SelectionMode="Single"
                                    GridLinesVisibility="Horizontal"
                                    HorizontalGridLinesBrush="#E5E7EB">
                                    <DataGrid.Columns>
                                        <DataGridTextColumn Width="1.4*" Binding="{Binding BootStart}" Header="启动时间" />
                                        <DataGridTextColumn Width="2.5*" Binding="{Binding Target}" Header="目标" />
                                        <DataGridTextColumn Width="1.8*" Binding="{Binding TargetMatch}" Header="匹配等级" />
                                        <DataGridTextColumn Width="1.2*" Binding="{Binding DegradationTime}" Header="退化值 (ms)" />
                                    </DataGrid.Columns>
                                    <DataGrid.RowDetailsTemplate>
                                        <DataTemplate>
                                            <Border Margin="0,2,0,6" Padding="12" Background="#F9FAFB" BorderBrush="#E5E7EB" BorderThickness="1" CornerRadius="6">
                                                <Grid>
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="*" />
                                                        <ColumnDefinition Width="*" />
                                                        <ColumnDefinition Width="2*" />
                                                    </Grid.ColumnDefinitions>
                                                    <StackPanel Margin="0,0,12,0">
                                                        <TextBlock Foreground="{StaticResource MutedBrush}" Text="事件与启动关联" />
                                                        <StackPanel Margin="0,4,0,8" Orientation="Horizontal">
                                                            <TextBlock Text="Record ID: " />
                                                            <TextBlock Text="{Binding EventRecordId}" />
                                                        </StackPanel>
                                                        <TextBlock Text="{Binding BootAssociation}" TextWrapping="Wrap" />
                                                        <StackPanel Margin="0,4,0,0" Orientation="Horizontal">
                                                            <TextBlock Text="事件记录时间: " />
                                                            <TextBlock Text="{Binding EventTime}" TextWrapping="Wrap" />
                                                        </StackPanel>
                                                    </StackPanel>
                                                    <StackPanel Grid.Column="1" Margin="0,0,12,0">
                                                        <TextBlock Foreground="{StaticResource MutedBrush}" Text="Windows 原始耗时" />
                                                        <StackPanel Margin="0,4,0,0" Orientation="Horizontal">
                                                            <TextBlock Text="TotalTime: " />
                                                            <TextBlock Text="{Binding TotalTime}" />
                                                            <TextBlock Text=" ms" />
                                                        </StackPanel>
                                                        <StackPanel Margin="0,4,0,0" Orientation="Horizontal">
                                                            <TextBlock Text="DegradationTime: " />
                                                            <TextBlock Text="{Binding DegradationTime}" />
                                                            <TextBlock Text=" ms" />
                                                        </StackPanel>
                                                    </StackPanel>
                                                    <StackPanel Grid.Column="2">
                                                        <TextBlock Foreground="{StaticResource MutedBrush}" Text="目标匹配说明与事件路径" />
                                                        <TextBlock Margin="0,4,0,8" Text="{Binding MatchDetails}" TextWrapping="Wrap" />
                                                        <TextBlock Text="{Binding Path}" TextWrapping="Wrap" />
                                                    </StackPanel>
                                                </Grid>
                                            </Border>
                                        </DataTemplate>
                                    </DataGrid.RowDetailsTemplate>
                                </DataGrid>
                            </Grid>
                        </Border>
                    </StackPanel>
                </ScrollViewer>
            </TabItem>
        </TabControl>

        <Border Grid.Row="3" Padding="24,11" Background="#E5E7EB">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <TextBlock
                    Foreground="{StaticResource MutedBrush}"
                    FontSize="12"
                    Text="数据来源：Windows Event Log、启动项配置、Win32_Process · 全程只读" />
                <TextBlock
                    x:Name="FooterStatusText"
                    Grid.Column="1"
                    Foreground="{StaticResource MutedBrush}"
                    FontSize="12"
                    Text="等待读取" />
            </Grid>
        </Border>
    </Grid>
</Window>
